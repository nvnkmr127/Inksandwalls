// INKs & Walls Prisma Schema Foundation
// Micro Phase: 01.03
// Canonical Spec: INKs-and-Walls-PRD.md §8

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemHealth {
  id        String   @id @default(cuid())
  status    String   @default("ok")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_health")
}

enum Role {
  GUEST
  CUSTOMER
  STORE_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id        String     @id @default(cuid())
  name      String?
  email     String?    @unique
  phone     String?    @unique
  image     String?
  role      Role       @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  accounts  Account[]
  customer  Customer?
  auditLogs AuditLog[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Customer {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  carts        Cart[]
  addresses    Address[]
  checkouts    CheckoutSession[]
  couponUsages CouponUsage[]
  orders       Order[]
  wishlists    Wishlist[]
  reviews      Review[]
  enquiries    Enquiry[]

  @@map("customers")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?  @map("actor_user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
  @@index([resourceType])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]
  seo      CategorySeo?

  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

enum ProductType {
  PER_AREA
  FIXED
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?     @db.Text
  productType ProductType @map("product_type")
  isActive    Boolean     @default(true) @map("is_active")

  // Monetary representation in integer minor units (paise)
  price Int? @map("price")
  rate  Int? @map("rate")

  // PER_AREA product fields
  wastage   Float? @map("wastage")
  minArea   Float? @map("min_area")
  rollWidth Float? @map("roll_width")

  // Catalogue configuration
  returnable Boolean @default(true) @map("returnable")
  hsnCode    String? @map("hsn_code")

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  variants     ProductVariant[]
  media        ProductMedia[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  wishlistedBy Wishlist[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reviews Review[]
  seo     ProductSeo?

  @@index([slug])
  @@index([categoryId])
  @@index([productType])
  @@index([isActive])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  name      String
  sku       String?  @unique
  price     Int      @map("price")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([isActive])
  @@index([sortOrder])
  @@map("product_variants")
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@map("collections")
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  objectKey String   @map("object_key")
  altText   String?  @map("alt_text") @db.Text
  width     Int?
  height    Int?
  format    String?
  mimeType  String?  @map("mime_type")
  size      Int?
  metadata  Json?
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sortOrder])
  @@index([isPrimary])
  @@index([productId, sortOrder])
  @@map("product_media")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

model Cart {
  id           String           @id @default(cuid())
  sessionId    String?          @unique @map("session_id") // Guest session identifier
  customerId   String?          @map("customer_id")
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status       CartStatus       @default(ACTIVE)
  email        String?
  phone        String?
  items        CartItem[]
  checkout     CheckoutSession?
  couponId     String?          @map("coupon_id")
  coupon       Coupon?          @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponUsages CouponUsage[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([sessionId])
  @@index([customerId])
  @@index([status])
  @@index([couponId])
  @@map("carts")
}

model CartItem {
  id     String @id @default(cuid())
  cartId String @map("cart_id")
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId   String      @map("product_id")
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String      @map("product_name")
  productType ProductType @map("product_type")

  variantId   String?         @map("variant_id")
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantName String?         @map("variant_name")
  sku         String?

  // PER_AREA dimensions & calculation snapshot
  width               Float?
  height              Float?
  unit                String?
  widthFt             Float?   @map("width_ft")
  heightFt            Float?   @map("height_ft")
  enteredAreaSqft     Float?   @map("entered_area_sqft")
  wastagePct          Float?   @map("wastage_pct")
  wastageAreaSqft     Float?   @map("wastage_area_sqft")
  areaWithWastageSqft Float?   @map("area_with_wastage_sqft")
  minAreaSqft         Float?   @map("min_area_sqft")
  isMinAreaApplied    Boolean? @map("is_min_area_applied")
  billableAreaSqft    Float?   @map("billable_area_sqft")
  rollWidthFt         Float?   @map("roll_width_ft")
  panelsNeeded        Int?     @map("panels_needed")
  ratePaise           Int?     @map("rate_paise") // minor units per sqft

  // Pricing & Quantity (authoritative integer minor units)
  unitPricePaise  Int @map("unit_price_paise")
  quantity        Int @default(1)
  totalPricePaise Int @map("total_price_paise")

  // Configuration snapshots & Media
  options    Json?
  mediaKey   String? @map("media_key")
  returnable Boolean @default(true)
  hsnCode    String? @map("hsn_code")

  // Deterministic configuration identity hash
  configHash String @map("config_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cartId, configHash])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@index([configHash])
  @@map("cart_items")
}

model Address {
  id         String    @id @default(cuid())
  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  firstName    String  @map("first_name")
  lastName     String  @map("last_name")
  addressLine1 String  @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String
  state        String
  postalCode   String  @map("postal_code")
  country      String  @default("IN")
  phone        String?

  isDefaultShipping Boolean @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean @default(false) @map("is_default_billing")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations for checkouts
  checkoutsShipping CheckoutSession[] @relation("CheckoutShippingAddress")
  checkoutsBilling  CheckoutSession[] @relation("CheckoutBillingAddress")

  @@index([customerId])
  @@map("addresses")
}

enum CheckoutStatus {
  ACTIVE
  EXPIRED
  COMPLETED
}

model CheckoutSession {
  id     String @id @default(cuid())
  cartId String @unique @map("cart_id")
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Restrict)

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  sessionId String? @map("session_id") // Guest session

  status CheckoutStatus @default(ACTIVE)

  email String
  phone String?

  shippingAddressId String?  @map("shipping_address_id")
  shippingAddress   Address? @relation("CheckoutShippingAddress", fields: [shippingAddressId], references: [id], onDelete: Restrict)

  billingAddressId String?  @map("billing_address_id")
  billingAddress   Address? @relation("CheckoutBillingAddress", fields: [billingAddressId], references: [id], onDelete: Restrict)

  deliveryOption      String?        @map("delivery_option")
  deliveryAmountPaise Int?           @map("delivery_amount_paise")
  paymentMethod       PaymentMethod? @map("payment_method")

  // Pricing snapshot
  subtotalPaise    Int @map("subtotal_paise")
  taxAmountPaise   Int @default(0) @map("tax_amount_paise")
  totalAmountPaise Int @map("total_amount_paise")

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([sessionId])
  @@index([status])
  @@map("checkout_sessions")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id                String       @id @default(cuid())
  code              String       @unique
  discountType      DiscountType @map("discount_type")
  discountValue     Int          @map("discount_value") // Percentage (1-100) or Fixed paise
  minCartValuePaise Int?         @map("min_cart_value_paise") // Minor units (paise)
  maxDiscountPaise  Int?         @map("max_discount_paise") // Minor units (paise)
  startDate         DateTime?    @map("start_date")
  expiryDate        DateTime?    @map("expiry_date")
  usageLimit        Int?         @map("usage_limit") // Global usage limit
  perCustomerLimit  Int?         @map("per_customer_limit") // Per-customer usage limit
  currentUsageCount Int          @default(0) @map("current_usage_count")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  carts  Cart[]
  usages CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model CouponUsage {
  id         String    @id @default(cuid())
  couponId   String    @map("coupon_id")
  coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cartId     String?   @map("cart_id")
  cart       Cart?     @relation(fields: [cartId], references: [id], onDelete: SetNull)
  usedAt     DateTime  @default(now()) @map("used_at")

  @@index([couponId])
  @@index([customerId])
  @@index([couponId, customerId])
  @@index([cartId])
  @@map("coupon_usages")
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  UNPAID
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  CONFIRMED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique @map("order_number")

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  guestSessionId String? @map("guest_session_id")
  customerEmail  String  @map("customer_email")
  customerPhone  String? @map("customer_phone")
  customerName   String  @map("customer_name")

  // Address snapshots (JSON for complete immutable historical isolation)
  shippingAddress Json @map("shipping_address")
  billingAddress  Json @map("billing_address")

  // Monetary snapshots in integer paise
  subtotalPaise Int @map("subtotal_paise")
  discountPaise Int @default(0) @map("discount_paise")
  shippingPaise Int @default(0) @map("shipping_paise")
  taxPaise      Int @default(0) @map("tax_paise")
  totalPaise    Int @map("total_paise")

  // Applied Coupon snapshot
  couponCode     String? @map("coupon_code")
  couponSnapshot Json?   @map("coupon_snapshot")

  // Tax & Shipping details snapshot
  taxBreakdown   Json?   @map("tax_breakdown")
  shippingOption String? @map("shipping_option")

  // Statuses
  paymentMethod     PaymentMethod     @map("payment_method")
  paymentStatus     PaymentStatus     @default(PENDING) @map("payment_status")
  fulfillmentStatus FulfillmentStatus @default(CONFIRMED) @map("fulfillment_status")

  // Online Payment reference
  razorpayOrderId   String? @unique @map("razorpay_order_id")
  razorpayPaymentId String? @unique @map("razorpay_payment_id")
  razorpaySignature String? @map("razorpay_signature")
  idempotencyKey    String? @unique @map("idempotency_key")

  // GST Invoice reference
  invoiceNumber      String?   @unique @map("invoice_number")
  invoiceUrl         String?   @map("invoice_url")
  invoiceR2Key       String?   @map("invoice_r2_key")
  invoiceGeneratedAt DateTime? @map("invoice_generated_at")

  // Fulfillment placeholders for Phase 08
  courierName  String?   @map("courier_name")
  awb          String?
  trackingUrl  String?   @map("tracking_url")
  shippedAt    DateTime? @map("shipped_at")
  deliveredAt  DateTime? @map("delivered_at")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")

  items    OrderItem[]
  payments Payment[]
  refunds  Refund[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderNumber])
  @@index([customerId])
  @@index([customerEmail])
  @@index([customerName])
  @@index([paymentMethod])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId String?         @map("variant_id")
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Product Snapshot
  productName String      @map("product_name")
  productSlug String?     @map("product_slug")
  productType ProductType @map("product_type")
  variantName String?     @map("variant_name")
  sku         String?
  hsnCode     String?     @map("hsn_code")
  returnable  Boolean     @default(true)
  mediaKey    String?     @map("media_key")
  options     Json?

  // PER_AREA dimensions snapshot
  width               Float?
  height              Float?
  unit                String?
  widthFt             Float?   @map("width_ft")
  heightFt            Float?   @map("height_ft")
  enteredAreaSqft     Float?   @map("entered_area_sqft")
  wastagePct          Float?   @map("wastage_pct")
  wastageAreaSqft     Float?   @map("wastage_area_sqft")
  areaWithWastageSqft Float?   @map("area_with_wastage_sqft")
  minAreaSqft         Float?   @map("min_area_sqft")
  isMinAreaApplied    Boolean? @map("is_min_area_applied")
  billableAreaSqft    Float?   @map("billable_area_sqft")
  rollWidthFt         Float?   @map("roll_width_ft")
  panelsNeeded        Int?     @map("panels_needed")
  ratePaise           Int?     @map("rate_paise")

  // Pricing snapshot (in integer paise)
  unitPricePaise     Int   @map("unit_price_paise")
  quantity           Int   @default(1)
  totalPricePaise    Int   @map("total_price_paise")
  discountPaise      Int   @default(0) @map("discount_paise")
  taxableAmountPaise Int   @default(0) @map("taxable_amount_paise")
  gstRatePct         Float @default(18) @map("gst_rate_pct")
  cgstPaise          Int   @default(0) @map("cgst_paise")
  sgstPaise          Int   @default(0) @map("sgst_paise")
  igstPaise          Int   @default(0) @map("igst_paise")
  totalTaxPaise      Int   @default(0) @map("total_tax_paise")
  netTotalPaise      Int   @map("net_total_paise")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id      String @id @default(cuid())
  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider          String // "RAZORPAY" | "COD"
  providerPaymentId String? @unique @map("provider_payment_id")
  providerOrderId   String? @map("provider_order_id")
  providerSignature String? @map("provider_signature")

  amountPaise Int           @map("amount_paise")
  currency    String        @default("INR")
  status      PaymentStatus @default(PENDING)
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  refunds   Refund[]

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([status])
  @@map("payments")
}

enum RefundStatus {
  INITIATED
  PROCESSED
  FAILED
}

model Refund {
  id      String @id @default(cuid())
  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  paymentId String  @map("payment_id")
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  providerRefundId String?      @unique @map("provider_refund_id")
  amountPaise      Int          @map("amount_paise")
  status           RefundStatus @default(INITIATED)

  initiatedByUserId String? @map("initiated_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([paymentId])
  @@index([providerRefundId])
  @@index([status])
  @@map("refunds")
}

model Wishlist {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
  @@map("wishlists")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id      String       @id @default(cuid())
  rating  Int          @db.SmallInt
  content String?      @db.Text
  status  ReviewStatus @default(PENDING)

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
  @@index([status])
  @@map("reviews")
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model Enquiry {
  id         String        @id @default(cuid())
  name       String
  phone      String
  message    String?       @db.Text
  source     String?
  status     EnquiryStatus @default(NEW)
  customerId String?       @map("customer_id")
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([customerId])
  @@map("enquiries")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  excerpt       String?    @db.Text
  content       String     @db.Text
  status        PostStatus @default(DRAFT)
  featuredImage String?    @map("featured_image")
  publishedAt   DateTime?  @map("published_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@map("blog_posts")
}

model Page {
  id        String     @id @default(cuid())
  title     String
  slug      String     @unique
  content   String     @db.Text
  status    PostStatus @default(DRAFT)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([slug])
  @@index([status])
  @@map("pages")
}

model ProductSeo {
  id                 String   @id @default(cuid())
  productId          String   @unique @map("product_id")
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  title              String?
  description        String?  @db.Text
  canonicalUrl       String?  @map("canonical_url")
  metaRobots         String?  @map("meta_robots")
  
  ogTitle            String?  @map("og_title")
  ogDescription      String?  @map("og_description") @db.Text
  ogImage            String?  @map("og_image")
  
  twitterTitle       String?  @map("twitter_title")
  twitterDescription String?  @map("twitter_description") @db.Text
  twitterImage       String?  @map("twitter_image")
  
  h1                 String?
  
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_seo")
}

model CategorySeo {
  id               String   @id @default(cuid())
  categoryId       String   @unique @map("category_id")
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  title            String?
  description      String?  @db.Text
  canonicalUrl     String?  @map("canonical_url")
  h1               String?
  introContent     String?  @map("intro_content") @db.Text
  
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@map("category_seo")
}
